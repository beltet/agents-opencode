{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "orchestrator",
  "instructions": [
    ".opencode/team/TEAM_RULES.md",
    ".opencode/team/WORKFLOW.md"
  ],
  "enabled_providers": [
    "openai",
    "opencode"
  ],
  "model": "openai/gpt-5.5",
  "subagent_depth": 2,
  "permission": {
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "bash": {
      "*": "allow",
      "python3 .opencode/tools/git_sync.py *": "allow",
      "git push*": "deny",
      "git pull*": "deny",
      "git fetch*": "deny",
      "git clone*": "deny",
      "git remote *": "deny",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "rm *": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "mkfs*": "deny",
      "dd *": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "telnet *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*credentials*": "deny",
      "*secrets*": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*credentials*": "deny",
      "*secrets*": "deny"
    },
    "doom_loop": "deny"
  },
  "agent": {
    "orchestrator": {
      "model": "openai/gpt-6.1-sol"
    },
    "system-architect": {
      "model": "openai/gpt-6.1-sol"
    },
    "technical-documenter": {
      "model": "openai/gpt-6-luna"
    },
    "image-analyst": {
      "model": "openai/gpt-6.1-terra"
    },
    "antenna-engineer": {
      "model": "openai/gpt-6.1-sol"
    },
    "audio-engineer": {
      "model": "openai/gpt-6.1-terra"
    },
    "code-reviewer": {
      "model": "openai/gpt-6.1-sol"
    },
    "communications-engineer": {
      "model": "openai/gpt-6.1-sol"
    },
    "crypto-mathematician": {
      "model": "openai/gpt-6.1-sol"
    },
    "database-engineer": {
      "model": "openai/gpt-6.1-terra"
    },
    "dsp-mathematician": {
      "model": "openai/gpt-6.1-sol"
    },
    "electronics-engineer": {
      "model": "openai/gpt-6.1-terra"
    },
    "fpga-engineer": {
      "model": "openai/gpt-6.1-sol"
    },
    "performance-engineer": {
      "model": "openai/gpt-6.1-sol"
    },
    "protocol-engineer": {
      "model": "openai/gpt-6.1-sol"
    },
    "radar-engineer": {
      "model": "openai/gpt-6.1-sol"
    },
    "radio-specialist": {
      "model": "openai/gpt-6.1-terra"
    },
    "rf-engineer": {
      "model": "openai/gpt-6.1-sol"
    },
    "software-engineer": {
      "model": "openai/gpt-6.1-sol"
    },
    "space-engineer": {
      "model": "openai/gpt-6.1-sol"
    },
    "technical-educator": {
      "model": "openai/gpt-6-luna"
    },
    "ux-ui-designer": {
      "model": "openai/gpt-6.1-terra"
    },
    "verification-engineer": {
      "model": "openai/gpt-6.1-sol"
    }
  }
}
