#!/usr/bin/env bash
# Portable Bash entry point; standard-library Python handles JSON and interactive menus.
set -euo pipefail
HERE="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ -f "$HERE/lib/manager.py" ]]; then
  ENGINE="$HERE/lib/manager.py"
else
  ENGINE="${XDG_DATA_HOME:-$HOME/.local/share}/agents-opencode/lib/manager.py"
fi
if [[ ! -f "$ENGINE" ]]; then
  printf 'Missing manager.py. Reinstall the full agentteam package.\n' >&2; exit 1
fi
exec python3 "$ENGINE" "$@"
