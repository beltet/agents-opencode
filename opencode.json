{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "permission": {
    "bash": {
      "*": "allow",
      "git push*": "allow",
      "git -C * push*": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "ssh *": "allow",
      "scp *": "allow",
      "rsync *": "allow",
      "git clone *": "allow",
      "git fetch *": "allow",
      "git pull *": "allow",
      "sudo *": "allow",
      "su *": "allow",
      "pkexec *": "allow",
      "rm *": "allow",
      "dd *": "allow",
      "mkfs*": "allow",
      "wipefs *": "allow",
      "shred *": "allow",
      "git reset --hard*": "allow",
      "git clean -fd*": "allow",
      "git push --force*": "allow",
      "git push -f *": "allow",
      "git -C * push --force*": "allow",
      "git -C * push -f *": "allow",
      "dnf *": "allow",
      "yum *": "allow",
      "apt *": "allow",
      "apt-get *": "allow",
      "pacman *": "allow",
      "pip install *": "allow",
      "pip3 install *": "allow",
      "python -m pip install *": "allow",
      "python3 -m pip install *": "allow",
      "cargo install *": "allow",
      "npm install -g *": "allow",
      "flashrom *": "allow",
      "dfu-util *": "allow",
      "openocd *": "allow",
      "uhd_image_loader *": "allow",
      "hackrf_transfer *": "allow"
    },
    "read": {
      "*": "allow",
      "/*": "allow",
      "*:/*": "allow",
      "*:\\*": "allow",
      "//*/**": "allow",
      "\\\\*": "allow",
      "/home/bjohel/git/agents-opencode": "allow",
      "/home/bjohel/git/agents-opencode/*": "allow",
      "/home/bjohel/git/agents-opencode/**": "allow",
      "*.env": "ask",
      "*.env.*": "ask",
      "*.pem": "ask",
      "*.key": "ask",
      "*id_rsa*": "ask",
      "*id_ed25519*": "ask",
      "*credentials*": "ask",
      "*secrets*": "ask",
      "*.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      "/*": "allow",
      "*:/*": "allow",
      "*:\\*": "allow",
      "//*/**": "allow",
      "\\\\*": "allow",
      "/home/bjohel/git/agents-opencode": "allow",
      "/home/bjohel/git/agents-opencode/*": "allow",
      "/home/bjohel/git/agents-opencode/**": "allow",
      "AGENT_ACCESS_POLICY.json": "deny",
      "/home/bjohel/git/agents-opencode/AGENT_ACCESS_POLICY.json": "deny",
      "/home/bjohel/git/agents-opencode/AGENT_ACCESS_POLICY.json/*": "deny",
      "/home/bjohel/git/agents-opencode/AGENT_ACCESS_POLICY.json/**": "deny",
      ".opencode/team/ACCESS_RULES.md": "deny",
      "/home/bjohel/git/agents-opencode/.opencode/team/ACCESS_RULES.md": "deny",
      "/home/bjohel/git/agents-opencode/.opencode/team/ACCESS_RULES.md/*": "deny",
      "/home/bjohel/git/agents-opencode/.opencode/team/ACCESS_RULES.md/**": "deny",
      ".opencode/tools/access_check.py": "deny",
      "/home/bjohel/git/agents-opencode/.opencode/tools/access_check.py": "deny",
      "/home/bjohel/git/agents-opencode/.opencode/tools/access_check.py/*": "deny",
      "/home/bjohel/git/agents-opencode/.opencode/tools/access_check.py/**": "deny",
      ".opencode/tools/access_fetch.py": "deny",
      "/home/bjohel/git/agents-opencode/.opencode/tools/access_fetch.py": "deny",
      "/home/bjohel/git/agents-opencode/.opencode/tools/access_fetch.py/*": "deny",
      "/home/bjohel/git/agents-opencode/.opencode/tools/access_fetch.py/**": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "*id_rsa*": "deny",
      "*id_ed25519*": "deny",
      "*credentials*": "deny",
      "*secrets*": "deny"
    },
    "external_directory": {
      "*": "allow"
    },
    "webfetch": "allow",
    "websearch": "allow",
    "doom_loop": "deny",
    "task": {
      "*": "deny",
      "code-reviewer": "allow",
      "orchestrator": "allow",
      "performance-engineer": "allow",
      "software-engineer": "allow",
      "system-architect": "allow",
      "technical-documenter": "allow",
      "technical-educator": "allow",
      "ux-ui-designer": "allow",
      "verification-engineer": "allow"
    },
    "mcp_*": "allow"
  },
  "instructions": [
    ".opencode/team/ACCESS_RULES.md"
  ],
  "enabled_providers": [
    "openai"
  ],
  "agent": {
    "code-reviewer": {
      "model": "openai/gpt-6.1-sol"
    },
    "orchestrator": {
      "model": "openai/gpt-6.1-sol"
    },
    "performance-engineer": {
      "model": "openai/gpt-6.1-sol"
    },
    "software-engineer": {
      "model": "openai/gpt-6.1-sol"
    },
    "system-architect": {
      "model": "openai/gpt-6.1-sol"
    },
    "technical-documenter": {
      "model": "openai/gpt-6-luna"
    },
    "technical-educator": {
      "model": "openai/gpt-6-luna"
    },
    "ux-ui-designer": {
      "model": "openai/gpt-6.1-terra"
    },
    "verification-engineer": {
      "model": "openai/gpt-6.1-sol"
    }
  },
  "default_agent": "orchestrator"
}
